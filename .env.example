# =========================================
#  信笺 — 资源持久化配置
# =========================================

# 1. 远端资源服务器 / CDN 地址（逗号分隔，按优先级排列）
#    配置后，客户端会先尝试从这些地址加载静态资源（BGM/图片/音频/信纸等），
#    全部失败才回退到本地服务器。
#    示例：RESOURCE_REMOTE_BASE_URLS=https://cdn.example.com/xinjian/,https://backup.example.com/assets/
RESOURCE_REMOTE_BASE_URLS=

# 2. 游戏领域（地图/角色/道具等）资源远端服务器
GAME_ASSET_BASE_URLS=
GAME_MANIFEST_BASE_URLS=

# 3. 资源缓存版本号（变动后客户端会强制清除本地缓存）
#    推荐格式：日期+序号，例如 20260804-v1
GAME_RESOURCE_VERSION=20260804-v1
